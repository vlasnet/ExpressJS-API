{
	"name": "expressjs-api",
	"version": "1.0.0",
	"description": "Demo API on the Express JS",
	"homepage": "https://github.com/vlasnet/ExpressJS-API#readme",
	"bugs": {
		"url": "https://github.com/vlasnet/ExpressJS-API/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vlasnet/ExpressJS-API.git"
	},
	"license": "ISC",
	"author": "Serhii Vlasiuk",
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"start": "tsc && node dist/main.js",
		"dev": "NODE_NO_WARNINGS=1 nodemon --exec node --loader ts-node/esm src/main.ts",
		"dev:inspect": "NODE_NO_WARNINGS=1 nodemon -e ts,json --exec node --inspect=localhost:9229 -r ts-node/register --loader ts-node/esm src/main.ts",
		"build": "tsc",
		"generate": "prisma generate",
		"test": "jest",
		"lint": "eslint ./src/**",
		"lint:fix": "eslint ./src/** --fix",
		"eslint": "eslint --max-warnings 0 --ext .ts,.tsx,.jsx,.js .",
		"prettier": "prettier \"**/*.{ts,tsx,js,jsx,scss,html,json,md}\"",
		"prettier:check": "npm run prettier -- --check",
		"prettier:fix": "npm run prettier -- --write",
		"review": "npm run prettier:fix && npm run lint && npm run build",
		"clinic": "clinic doctor --on-port 'autocannon -m POST localhost:$PORT/users/register' -- node dist/main.js"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"inversify": "^7.11.0",
		"jsonwebtoken": "^9.0.3",
		"reflect-metadata": "^0.2.2",
		"tslog": "^4.10.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.0.10",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^30.2.0",
		"nodemon": "^3.1.11",
		"prettier": "^3.8.1",
		"prisma": "^7.3.0",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0"
	}
}
